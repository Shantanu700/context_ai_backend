# Production environment. Copy to .env.prod and fill in — never commit the result.

DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

# Auth / CORS — lock to the client origin, no wildcard in production
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://client.example.com
SESSION_COOKIE_SECURE=True

# Managed postgres. Supabase: Project Settings -> Database -> Connection string -> URI,
# session pooler (port 5432). The transaction pooler (6543) also works — settings.py
# disables prepared statements for it automatically.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# only used by the optional bundled db service: --profile localdb
POSTGRES_PASSWORD=postgres
WEB_PORT=8000

# Media must live in object storage: containers are disposable
STORAGE_BACKEND=r2
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_URL_EXPIRE=3600

# Gemini — a paid key lifts SCENE_ANALYSIS_RATE well above the free tier's 15 rpm
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
SCENE_ANALYSIS_RATE=4/m

MAX_VIDEO_SECONDS=300
TMP_CACHE_HOURS=6
WHISPER_MODEL=base
EMBEDDING_DEVICE=cpu
LOG_LEVEL=INFO
