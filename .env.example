# Django
SECRET_KEY=dev-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=*

# Services (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/context_ai
REDIS_URL=redis://localhost:6380/0

# Storage: local | r2
STORAGE_BACKEND=local
# MEDIA_ROOT=./media
# Only needed when STORAGE_BACKEND=r2
# R2_BUCKET=context-ai
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_URL_EXPIRE=3600

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
SCENE_ANALYSIS_RATE=4/m
TOP_K_ADS=3
IAB_BOOST=0.15

# Pipeline
# Meridian (the sample video) is ~12 min, so raise this from the 300s default to run it.
MAX_VIDEO_SECONDS=900
WHISPER_MODEL=base
SCENE_THRESHOLD=27.0
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# cpu, mps or cuda. Keep cpu on macOS: torch's Metal kernels crash under worker threads.
EMBEDDING_DEVICE=cpu
